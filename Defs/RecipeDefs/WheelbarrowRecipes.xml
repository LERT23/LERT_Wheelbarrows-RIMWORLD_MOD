<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef Name="LERT_WB_RecipeBase" Abstract="True">
    <workSkill>Crafting</workSkill>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>ConstructMetal</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
  </RecipeDef>
  <RecipeDef ParentName="LERT_WB_RecipeBase">
    <defName>LERT_WB_MakeWood</defName>
    <label>make wooden wheelbarrow</label>
    <jobString>Making a wooden wheelbarrow.</jobString>
    <workAmount>1500</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>80</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <LERT_WB_Wood>1</LERT_WB_Wood>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>
  <RecipeDef ParentName="LERT_WB_RecipeBase">
